# ================================================================
# .env.example — Projeto Luna Secretaria IA
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commit o arquivo .env — ele já está no .gitignore
# ================================================================

# ── ANTHROPIC (Claude API) ───────────────────────────────────────
# Obtenha em: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SUPABASE ─────────────────────────────────────────────────────
# Obtenha em: Supabase → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGcixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGcixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP (Z-API ou Evolution API) ────────────────────────────
# Obtenha em: painel da Z-API → sua instância
ZAPI_INSTANCIA=NOME_DA_INSTANCIA
ZAPI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZAPI_CLIENT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Se usar Evolution API self-hosted:
EVOLUTION_API_URL=https://SUA_EVOLUTION.up.railway.app
EVOLUTION_API_KEY=SUA_CHAVE_SECRETA

# ── GOOGLE CALENDAR ───────────────────────────────────────────────
# Obtenha em: console.cloud.google.com → Credenciais
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALENDAR_ID=seu_calendario@group.calendar.google.com

# ── N8N ──────────────────────────────────────────────────────────
# URL pública do seu n8n (Railway, VPS etc.)
N8N_URL=https://SEU_N8N.up.railway.app
N8N_WEBHOOK_PATH=whatsapp-estetica

# ── TELEGRAM (notificações de queda — opcional) ──────────────────
# Obtenha em: @BotFather no Telegram
TELEGRAM_BOT_TOKEN=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

# ── STRIPE / PAGAR.ME (cobrança recorrente) ───────────────────────
# Obtenha em: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
